# Database
DATABASE_URL=postgres://openb00ks_user:openb00ks_dev@127.0.0.1:5436/openb00ks?sslmode=disable

# API server
API_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5177

# Auth
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=86400
REFRESH_TTL_SECONDS=2592000

# Receipt storage
RECEIPT_STORAGE=local
RECEIPT_LOCAL_DIR=./.data/receipts
RECEIPT_MAX_BYTES=10485760

# AI configuration
# Set to "openai" to enable AI suggestions, "none" for rules-only
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_INPUT_CENTS_PER_1K_TOKENS=15
AI_OUTPUT_CENTS_PER_1K_TOKENS=60

# Search configuration
# Set to "typesense" to enable historical retrieval and indexed search
SEARCH_PROVIDER=none
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=dev-typesense-key
TYPESENSE_COLLECTION_PREFIX=openb00ks

# Worker settings
WORKER_ID=worker-1
QUEUE_BATCH=5
QUEUE_LOCK_SECONDS=300
QUEUE_MAX_ATTEMPTS=5
